{
    "compilerOptions": {
      "target": "ES6",
      "module": "ESNext",
      "lib": ["DOM", "ES2015"],
      "declaration": true,
      "outDir": "./dist",
      "strict": true,
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "baseUrl": "./src",
      "paths": {
        "@core/*": ["core/*"],
        "@services/*": ["services/*"],
        "@types/*": ["types/*"]
      }
    },
    "include": ["src/**/*"],
    // "exclude": ["node_modules", "**/*.test.ts"]
  }